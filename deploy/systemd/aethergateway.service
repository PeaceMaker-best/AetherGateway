[Unit]
Description=AetherGateway local Claude model gateway
Documentation=https://github.com/PeaceMaker-best/AetherGateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/aethergateway/aethergateway.env
Environment=RUST_LOG=model_port=info,tower_http=info
Environment=AETHERGATEWAY_STATE_DIR=/var/lib/aethergateway
ExecStart=/usr/local/bin/model-port
WorkingDirectory=/var/lib/aethergateway
Restart=always
RestartSec=3

DynamicUser=true
StateDirectory=aethergateway
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
