# Docker Compose environment reference.
# Choose DeepSeek-only, local-Qwen-only, or combined topology before startup.
# DeepSeek upstream keys belong only here/your secret manager; SignalFoundry receives
# a separately issued scoped AetherGateway client API key. Full recipes:
# docs/CONFIGURATION.md#provider-topology-recipes
#
# Copy to .env before running docker compose:
#   cp deploy/docker/aethergateway.env.example .env
#
# Keep the published ports on 127.0.0.1 for personal use. Change to
# 0.0.0.0:38082 / 0.0.0.0:33002 only when your LAN or reverse proxy should reach it.
AETHERGATEWAY_API_PUBLISH=127.0.0.1:38082
AETHERGATEWAY_DASHBOARD_PUBLISH=127.0.0.1:33002

# Container runtime. docker-compose.yml overrides AETHERGATEWAY_BIND to 0.0.0.0:38082
# inside the container, so this value is mainly useful for local scripts.
AETHERGATEWAY_BIND=127.0.0.1:38082
AETHERGATEWAY_AUTH_TOKEN=replace-with-a-long-random-local-token
AETHERGATEWAY_ADMIN_USERNAME=admin
AETHERGATEWAY_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# Enterprise mode enables this automatically. Set it explicitly to require
# two distinct administrators for high-risk changes in another deployment.
# AETHERGATEWAY_REQUIRE_DUAL_APPROVAL=1
# Optional for the local Compose readiness probe. When omitted, Compose uses
# AETHERGATEWAY_AUTH_TOKEN. Shared deployments should create a dedicated scoped key.
# AETHERGATEWAY_HEALTHCHECK_API_KEY=replace-with-a-dedicated-readiness-key
# Enterprise first start atomically creates a distinct Backup administrator.
# AETHERGATEWAY_BACKUP_ADMIN_USERNAME=backup-admin
# AETHERGATEWAY_BACKUP_ADMIN_EMAIL=backup-admin@example.com
# AETHERGATEWAY_BACKUP_ADMIN_PASSWORD=replace-with-another-long-random-password
AETHERGATEWAY_DEFAULT_PROVIDER=deepseek
# AETHERGATEWAY_SMART_ROUTING_MODE=off
# AETHERGATEWAY_SMART_ROUTING_PROFILE=balanced
# AETHERGATEWAY_SMART_ROUTING_ACTIVATION_PERCENT=0
AETHERGATEWAY_ADMIN_SESSION_TTL_SECONDS=43200

# Optional console OIDC sign-in. It is disabled by default. Set the three
# required values together; the callback path is always /admin/auth/oidc/callback.
# AETHERGATEWAY_OIDC_ISSUER=https://identity.example.com/realms/aethergateway
# AETHERGATEWAY_OIDC_CLIENT_ID=aethergateway
# AETHERGATEWAY_OIDC_REDIRECT_URI=https://aethergateway.example.com/admin/auth/oidc/callback
# Optional confidential-client secret.
# AETHERGATEWAY_OIDC_CLIENT_SECRET=replace-with-client-secret
# AETHERGATEWAY_OIDC_LABEL=Company SSO
# After verifying a linked SSO administrator, optionally enforce SSO/MFA class:
# AETHERGATEWAY_PASSWORD_LOGIN_ENABLED=0
# AETHERGATEWAY_OIDC_REQUIRED_ACR=urn:example:authentication:mfa
# Automatic provisioning is off by default; pre-create users initially.
# AETHERGATEWAY_OIDC_AUTO_PROVISION=0
# AETHERGATEWAY_OIDC_USERNAME_CLAIM=preferred_username
# AETHERGATEWAY_OIDC_EMAIL_CLAIM=email
# Loopback development only; never enable for a remote production identity
# provider.
# AETHERGATEWAY_OIDC_ALLOW_INSECURE_HTTP=1
# Production OIDC hardening:
# AETHERGATEWAY_ADMIN_COOKIE_SECURE=1
# AETHERGATEWAY_ALLOWED_ORIGINS=https://aethergateway.example.com
# AETHERGATEWAY_REQUIRE_CONTROL_API_KEYS=1

AETHERGATEWAY_MAX_REQUEST_BODY_BYTES=33554432
AETHERGATEWAY_MAX_CONCURRENT_REQUESTS=64
# Defaults to AETHERGATEWAY_MAX_CONCURRENT_REQUESTS; held until stream body completion/drop.
# AETHERGATEWAY_MAX_CONCURRENT_STREAMS=64
AETHERGATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
AETHERGATEWAY_RATE_LIMIT_GLOBAL_PER_MINUTE=6000
AETHERGATEWAY_RATE_LIMIT_API_KEY_PER_MINUTE=600
AETHERGATEWAY_RATE_LIMIT_IP_PER_MINUTE=1200
AETHERGATEWAY_RATE_LIMIT_PROVIDER_PER_MINUTE=3000
AETHERGATEWAY_RATE_LIMIT_MODEL_PER_MINUTE=1200
AETHERGATEWAY_MAX_MODEL_NAME_CHARS=240
AETHERGATEWAY_MAX_MESSAGES=200
AETHERGATEWAY_MAX_MESSAGES_JSON_CHARS=2097152
AETHERGATEWAY_MAX_SYSTEM_JSON_CHARS=262144
AETHERGATEWAY_MAX_TOOLS=256
AETHERGATEWAY_MAX_TOOLS_JSON_CHARS=1048576
# POST /v1/messages requires max_tokens > 0 and rejects values above this cap.
AETHERGATEWAY_MAX_OUTPUT_TOKENS=131072

# PostgreSQL is internal to docker-compose by default. It does not publish 5432
# on the host, so it will not conflict with other PostgreSQL instances.
AETHERGATEWAY_POSTGRES_DB=aethergateway
AETHERGATEWAY_POSTGRES_USER=aethergateway
# Compose embeds this value in a connection URL. Use a long URL-safe value
# (letters, digits, `_`, `-`) unless you percent-encode reserved characters.
AETHERGATEWAY_POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
# Optional override when you need a fully percent-encoded connection URL.
# When set to an external PostgreSQL, the internal `postgres` compose container
# is NOT started (it moves to the "internal-db" Compose profile). Leave unset or
# empty to keep the internal Compose database.
# AETHERGATEWAY_DATABASE_URL=postgres://aethergateway:encoded-password@postgres:5432/aethergateway
# The internal Compose database has no TLS certificate; development defaults to
# `prefer` and falls back to the private bridge. Remote enterprise databases
# must use verify-full and a trusted sslrootcert in the URL.
# AETHERGATEWAY_DATABASE_TLS_MODE=prefer
# AETHERGATEWAY_DATABASE_MAX_CONNECTIONS=16
# AETHERGATEWAY_DATABASE_MIN_CONNECTIONS=0
# AETHERGATEWAY_DATABASE_ACQUIRE_TIMEOUT_SECS=10
# AETHERGATEWAY_LEDGER_LEASE_TTL_SECS=300
# AETHERGATEWAY_LEDGER_RECONCILE_INTERVAL_SECS=60
# AETHERGATEWAY_FINALIZATION_DRAIN_TIMEOUT_SECONDS=30
# Compose allows the default 600-second request timeout plus finalizer drain.
# AETHERGATEWAY_STOP_GRACE_PERIOD=11m

# Admin-triggered retention policy. Run POST /admin/retention/run with dryRun=true
# before applying. Prompt/response/tool content is never intentionally persisted.
# AETHERGATEWAY_REQUEST_DETAIL_RETENTION_DAYS=30
# AETHERGATEWAY_USER_USAGE_RETENTION_DAYS=90
# AETHERGATEWAY_AUDIT_RETENTION_DAYS=395
# Set during an incident, investigation, or approved legal hold. Dry-run remains
# available; apply returns applied=false while the hold is active.
# AETHERGATEWAY_RETENTION_LEGAL_HOLD=0
# AETHERGATEWAY_ENTERPRISE_DATABASE_URL=postgres://aethergateway:encoded-password@postgres:5432/aethergateway
# Enterprise mode also requires secure cookies, an HTTPS allowed origin, explicit
# trusted proxies, control API keys, and enabled CSRF protection.
# AETHERGATEWAY_ENTERPRISE_MODE=1

# Security hardening.
# Forwarded IP headers are trusted only from these proxy IPs/CIDRs. AetherGateway
# strips trusted hops right-to-left; bundled Nginx overwrites XFF with remote_addr.
# The Docker dashboard container reaches the backend from the bridge network.
AETHERGATEWAY_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12
# Optional comma-separated origins for console write requests when Host and Origin differ.
# AETHERGATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:33002
# Emergency/local debugging only; do not enable in production.
# AETHERGATEWAY_DISABLE_CSRF=1
# Team/shared deployments can require dashboard-issued API keys for /v1 and /metrics.
# AETHERGATEWAY_REQUIRE_CONTROL_API_KEYS=1
# Keep detailed provider health behind auth by default.
# AETHERGATEWAY_EXPOSE_DETAILED_HEALTH=1
# Optional read-only operations Agent. Create a service-account key with exact
# purpose `aethergateway_ops_agent`; start the optional Compose profile in shadow.
# AETHERGATEWAY_OPS_API_KEY=mp_...
# Optional, separate least-privilege inference key for model-assisted diagnosis.
# AETHERGATEWAY_OPS_MODEL_API_KEY=mp_...
# AETHERGATEWAY_OPS_MODE=shadow
# AETHERGATEWAY_OPS_INTERVAL_SECONDS=300
# AETHERGATEWAY_OPS_CPU_LIMIT=0.50
# AETHERGATEWAY_OPS_MEMORY_LIMIT=256m
# AETHERGATEWAY_OPS_PIDS_LIMIT=128
# AETHERGATEWAY_OPS_WEBHOOK_URL=https://hooks.example.com/aethergateway
# Only enable for trusted internal networks with private provider base URLs.
# AETHERGATEWAY_ALLOW_PRIVATE_PROVIDER_URLS=1
# Remote providers require HTTPS. This exposes API keys and prompts in plaintext;
# use only for a trusted internal HTTP upstream; local/custom HTTP is unaffected.
# AETHERGATEWAY_ALLOW_INSECURE_PROVIDER_HTTP=1

# Native HTTP transport.
AETHERGATEWAY_HTTP_CONNECT_TIMEOUT_SECS=10
# Complete non-stream timeout; SSE uses this for handshake and error-body total reads.
AETHERGATEWAY_HTTP_REQUEST_TIMEOUT_SECS=600
# Established SSE and error-body reads reset this timeout on every chunk.
AETHERGATEWAY_HTTP_STREAM_IDLE_TIMEOUT_SECS=300
AETHERGATEWAY_HTTP_MAX_RESPONSE_BYTES=33554432
AETHERGATEWAY_HTTP_SSE_MAX_LINE_BYTES=1048576
AETHERGATEWAY_HTTP_SSE_MAX_EVENT_BYTES=8388608
AETHERGATEWAY_HTTP_SSE_MAX_STREAM_BYTES=67108864

# DeepSeek official Anthropic-compatible API.
# Remove this block for a Qwen-only topology and set the TOML default accordingly.
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_ANTHROPIC_AUTH_TOKEN=replace-with-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Xiaomi/Mimo OpenAI-compatible API.
# BASE_URL=https://w.ciykj.cn/v1
# MIMO_OPENAI_API_KEY=replace-with-real-mimo-api-key
# MIMO_MODEL=mimo-v2.5-pro

# Optional CLIProxyAPI (CPA) sidecar. Attach CPA to the same private Docker
# network under the DNS name `cpa`; do not publish port 8317 to the host.
# Both Providers may use the same CPA client key, but remain separately routed.
# The standard Compose path uses TOML, so add the records documented in
# docs/CONFIGURATION.md as well as these environment values.
# AETHERGATEWAY_ENABLE_CPA_CODEX=1
# CPA_CODEX_BASE_URL=http://cpa:8317/v1
# CPA_CODEX_API_KEY=replace-with-cpa-client-api-key
# CPA_CODEX_MODEL=gpt-5.3-codex
# CPA_CODEX_MODELS=gpt-5.3-codex
# AETHERGATEWAY_ENABLE_CPA_CLAUDE=1
# CPA_CLAUDE_BASE_URL=http://cpa:8317
# CPA_CLAUDE_API_KEY=replace-with-cpa-client-api-key
# CPA_CLAUDE_MODEL=claude-sonnet-4-6
# CPA_CLAUDE_MODELS=claude-sonnet-4-6

# Optional OpenAI upstream for the AetherGateway server. Do not use client-side
# OPENAI_BASE_URL=http://127.0.0.1:38082/v1 in this server environment.
# AETHERGATEWAY_OPENAI_API_KEY=replace-with-real-openai-api-key
# AETHERGATEWAY_OPENAI_BASE_URL=https://api.openai.com/v1
# AETHERGATEWAY_OPENAI_MODEL=gpt-5.5
# AETHERGATEWAY_OPENAI_MODELS=gpt-5.5,gpt-5.4,gpt-4.1

# Optional: local runtimes on the Docker host should use host.docker.internal.
# The maintained SignalFoundry topology uses a TOML provider named local_qwen:
# QWEN_LOCAL_BASE_URL=http://qwen-runtime:8080/v1
# AETHERGATEWAY_ENABLE_OLLAMA=1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=llama3.1
# CUSTOM_OPENAI_BASE_URL=http://host.docker.internal:8000/v1
# CUSTOM_OPENAI_API_KEY=optional-custom-key
# CUSTOM_OPENAI_MODEL=default

# Claude Code / VS Code Claude on the host should use the published API port.
ANTHROPIC_BASE_URL=http://127.0.0.1:38082
ANTHROPIC_AUTH_TOKEN=replace-with-the-same-local-router-token
ANTHROPIC_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
ANTHROPIC_SMALL_FAST_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
